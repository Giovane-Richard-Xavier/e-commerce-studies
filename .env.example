PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token

# Tempo de vida dos tokens, em segundos (900 = 15 min, 604800 = 7 dias)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Usado apenas pelo seed (npm run prisma:seed) para criar o primeiro admin
ADMIN_EMAIL=example@example.com
ADMIN_PASSWORD=Example12345